[importlinter]
include_external_packages = True
root_packages =
    rbrs

[importlinter:contract:1]
name = Extraction layer must never import decision modules
type = forbidden
source_modules =
    rbrs.extraction
forbidden_modules =
    rbrs.rules
    rbrs.inference
    rbrs.constraints
    rbrs.scoring
    rbrs.pipeline
    rbrs.experiments
    rbrs.analysis
    rbrs.synthetic
    rbrs.audit

[importlinter:contract:2]
name = Decision layers depend downwards only (L5 scoring > L4 constraints > L3 inference > L2 rules > L1 profile)
type = layers
layers =
    rbrs.scoring
    rbrs.constraints
    rbrs.inference
    rbrs.rules
    rbrs.profile

[importlinter:contract:3]
name = Decision layer never imports the LLM SDK
type = forbidden
source_modules =
    rbrs.profile
    rbrs.rules
    rbrs.inference
    rbrs.constraints
    rbrs.scoring
    rbrs.pipeline
forbidden_modules =
    google
allow_indirect_imports = False
